{<<"links">>,[{<<"GitHub">>,<<"https://github.com/bokner/replbug">>}]}.
{<<"name">>,<<"replbug">>}.
{<<"version">>,<<"1.0.2">>}.
{<<"description">>,
 <<"Replbug is an addition to Rexbug that allows to inspect Erlang VM traces as variables in IEx">>}.
{<<"elixir">>,<<"~> 1.14">>}.
{<<"app">>,<<"replbug">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"redbug_clone">>},
   {<<"app">>,<<"redbug_clone">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 2.0.10">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"erlang_term">>},
   {<<"app">>,<<"erlang_term">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 2.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"files">>,
 [<<"lib">>,<<"lib/replbug_collector.ex">>,<<"lib/replbug_utils.ex">>,
  <<"lib/replbug.ex">>,<<"lib/rexbug_copy">>,<<"lib/rexbug_copy/printing">>,
  <<"lib/rexbug_copy/printing/utils.ex">>,<<"lib/rexbug_copy/translator.ex">>,
  <<"lib/rexbug_copy/printing.ex">>,<<".formatter.exs">>,<<"mix.exs">>,
  <<"README.md">>,<<"LICENSE">>]}.
{<<"build_tools">>,[<<"mix">>]}.
